(run "#358 early (astep)")
(init (enabled))
(step 1 (OInsert provider) (del) (add (fiber 0 provider (life Inactive) (target))) (enabled (LBegin 0)))
(step 2 (OInsert consumer) (del) (add (fiber 1 consumer (life Inactive) (target none))) (enabled (LBegin 0)))
(step 3 (LBegin 0)
  (del (fiber 0 provider (life Inactive) (target)))
  (add (fiber 0 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (enabled (LStep 0)))
(step 4 (LStep 0)
  (del (fiber 0 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (add
    (fiber 0 provider (life Loading) (view) (target) (next done) (acc (prov tools 2)))
    (bind tools (pid 2) (owner 0) (entries)))
  (enabled (LStep 0)))
(step 5 (LStep 0)
  (del
    (fiber 0 provider (life Loading) (view) (target) (next done) (acc (prov tools 2)))
    (fiber 1 consumer (life Inactive) (target none)))
  (add
    (fiber 0 provider (life Active) (view) (target) (acc (prov tools 2)))
    (fiber 1 consumer (life Inactive) (target (tools 2))))
  (enabled (LBegin 1)))
(step 6 (LBegin 1)
  (del (fiber 1 consumer (life Inactive) (target (tools 2))))
  (add (fiber 1 consumer (life Loading) (view (tools 2)) (target (tools 2)) (next (op tools (register 7 42))) (acc)))
  (enabled (LStep 1)))
(step 7 (LStep 1)
  (del
    (fiber 1 consumer (life Loading) (view (tools 2)) (target (tools 2)) (next (op tools (register 7 42))) (acc))
    (bind tools (pid 2) (owner 0) (entries)))
  (add
    (fiber 1 consumer (life Loading) (view (tools 2)) (target (tools 2)) (next done) (acc (op tools 2 (register 7 42))))
    (bind tools (pid 2) (owner 0) (entries (7 42))))
  (enabled (LStep 1)))
(step 8 (LStep 1)
  (del
    (fiber 1 consumer (life Loading) (view (tools 2)) (target (tools 2)) (next done) (acc (op tools 2 (register 7 42)))))
  (add (fiber 1 consumer (life Active) (view (tools 2)) (target (tools 2)) (acc (op tools 2 (register 7 42)))))
  (enabled))
(step 9 (ODispose 0)
  (del (fiber 0 provider (life Active) (view) (target) (acc (prov tools 2))))
  (add (fiber 0 provider (life Active) disposed (view) (target none) (acc (prov tools 2))))
  (enabled (LLeave 0)))
(step 10 (LLeave 0)
  (del
    (fiber 0 provider (life Active) disposed (view) (target none) (acc (prov tools 2)))
    (fiber 1 consumer (life Active) (view (tools 2)) (target (tools 2)) (acc (op tools 2 (register 7 42)))))
  (add
    (fiber 0 provider (life Unloading) disposed held (view) (target none) (acc (prov tools 2)))
    (fiber 1 consumer (life Active) (view (tools 2)) (target none) (acc (op tools 2 (register 7 42)))))
  (enabled (LLeave 1)))
(step 11 (LLeave 1)
  (del (fiber 1 consumer (life Active) (view (tools 2)) (target none) (acc (op tools 2 (register 7 42)))))
  (add (fiber 1 consumer (life Unloading) (view (tools 2)) (target none) (acc (op tools 2 (register 7 42)))))
  (enabled (LUndo 1)))
(step 12 (OInsert provider) (del) (add (fiber 4 provider (life Inactive) (target))) (enabled (LUndo 1) (LBegin 4)))
(step 13 (LBegin 4)
  (del (fiber 4 provider (life Inactive) (target)))
  (add (fiber 4 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (enabled (LUndo 1) (LStep 4)))
(step 14 (LStep 4)
  (del (fiber 4 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (add (fiber 4 provider (life Unloading EConflict) (view) (target) (acc)))
  (enabled (LUndo 1) (LUnloaded 4)))
(step 15 (LUnloaded 4)
  (del (fiber 4 provider (life Unloading EConflict) (view) (target) (acc)))
  (add (fiber 4 provider (life Inactive EConflict) (target)))
  (enabled (LUndo 1)))
(step 16 (LUndo 1)
  (del
    (fiber 1 consumer (life Unloading) (view (tools 2)) (target none) (acc (op tools 2 (register 7 42))))
    (bind tools (pid 2) (owner 0) (entries (7 42))))
  (add
    (fiber 1 consumer (life Unloading) (view (tools 2)) (target none) (acc))
    (bind tools (pid 2) (owner 0) (entries)))
  (enabled (LUnloaded 1)))
(step 17 (LUnloaded 1)
  (del
    (fiber 0 provider (life Unloading) disposed held (view) (target none) (acc (prov tools 2)))
    (fiber 1 consumer (life Unloading) (view (tools 2)) (target none) (acc)))
  (add
    (fiber 0 provider (life Unloading) disposed (view) (target none) (acc (prov tools 2)))
    (fiber 1 consumer (life Inactive) (target none)))
  (enabled (LUndo 0)))
(step 18 (LUndo 0)
  (del
    (fiber 0 provider (life Unloading) disposed (view) (target none) (acc (prov tools 2)))
    (bind tools (pid 2) (owner 0) (entries)))
  (add (fiber 0 provider (life Unloading) disposed (view) (target none) (acc)))
  (enabled (LUnloaded 0)))
(step 19 (LUnloaded 0)
  (del (fiber 0 provider (life Unloading) disposed (view) (target none) (acc)))
  (add (fiber 0 provider (life Inactive) disposed (target none)))
  (enabled (LRemove 0)))
(step 20 (LRemove 0) (del (fiber 0 provider (life Inactive) disposed (target none))) (add) (enabled))
(step 21 (LBegin 1) refused)
(step 22 (LBegin 4) refused)
(final
  (fiber 1 consumer (life Inactive) (target none))
  (fiber 4 provider (life Inactive EConflict) (target))
  (quiet #t))
