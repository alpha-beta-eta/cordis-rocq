(run "ViewFail A (vstep)")
(init (enabled))
(step 1 (OInsert provider7) (del) (add (fiber 0 provider7 (life Inactive) (target))) (enabled (LBegin 0)))
(step 2 (OInsert consumer) (del) (add (fiber 1 consumer (life Inactive) (target none))) (enabled (LBegin 0)))
(step 3 (LBegin 0)
  (del (fiber 0 provider7 (life Inactive) (target)))
  (add (fiber 0 provider7 (life Loading) (view) (target) (next (provide tools)) (acc)))
  (enabled (LStep 0)))
(step 4 (LStep 0)
  (del (fiber 0 provider7 (life Loading) (view) (target) (next (provide tools)) (acc)))
  (add
    (fiber 0 provider7 (life Loading) (view) (target) (next done) (acc (prov tools 2)))
    (bind tools (pid 2) (owner 0) (entries (7 0))))
  (enabled (LStep 0)))
(step 5 (LStep 0)
  (del
    (fiber 0 provider7 (life Loading) (view) (target) (next done) (acc (prov tools 2)))
    (fiber 1 consumer (life Inactive) (target none)))
  (add
    (fiber 0 provider7 (life Active) (view) (target) (acc (prov tools 2)))
    (fiber 1 consumer (life Inactive) (target (tools 2))))
  (enabled (LBegin 1)))
(step 6 (LBegin 1)
  (del (fiber 1 consumer (life Inactive) (target (tools 2))))
  (add (fiber 1 consumer (life Loading) (view (tools 2)) (target (tools 2)) (next (op tools (register 7 42))) (acc)))
  (enabled (LStep 1)))
(step 7 (LStep 1)
  (del (fiber 1 consumer (life Loading) (view (tools 2)) (target (tools 2)) (next (op tools (register 7 42))) (acc)))
  (add (fiber 1 consumer (life Unloading EOp) (view (tools 2)) (target (tools 2)) (acc)))
  (enabled (LUnloaded 1)))
(step 8 (LUnloaded 1)
  (del (fiber 1 consumer (life Unloading EOp) (view (tools 2)) (target (tools 2)) (acc)))
  (add (fiber 1 consumer (life Inactive EOp) (target (tools 2))) (fview 1 (tools 2)))
  (enabled))
(step 9 (ODispose 0)
  (del (fiber 0 provider7 (life Active) (view) (target) (acc (prov tools 2))))
  (add (fiber 0 provider7 (life Active) disposed (view) (target none) (acc (prov tools 2))))
  (enabled (LLeave 0)))
(step 10 (LLeave 0)
  (del
    (fiber 0 provider7 (life Active) disposed (view) (target none) (acc (prov tools 2)))
    (fiber 1 consumer (life Inactive EOp) (target (tools 2))))
  (add
    (fiber 0 provider7 (life Unloading) disposed (view) (target none) (acc (prov tools 2)))
    (fiber 1 consumer (life Inactive EOp) (target none)))
  (enabled (LUndo 0) (VClear 1)))
(step 11 (LUndo 0)
  (del
    (fiber 0 provider7 (life Unloading) disposed (view) (target none) (acc (prov tools 2)))
    (bind tools (pid 2) (owner 0) (entries (7 0))))
  (add (fiber 0 provider7 (life Unloading) disposed (view) (target none) (acc)))
  (enabled (LUnloaded 0) (VClear 1)))
(step 12 (LUnloaded 0)
  (del (fiber 0 provider7 (life Unloading) disposed (view) (target none) (acc)))
  (add (fiber 0 provider7 (life Inactive) disposed (target none)) (fview 0))
  (enabled (LRemove 0) (VClear 1)))
(step 13 (LRemove 0) (del (fiber 0 provider7 (life Inactive) disposed (target none))) (add) (enabled (VClear 1)))
(step 14 (OInsert provider) (del) (add (fiber 4 provider (life Inactive) (target))) (enabled (LBegin 4) (VClear 1)))
(step 15 (LBegin 4)
  (del (fiber 4 provider (life Inactive) (target)))
  (add (fiber 4 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (enabled (LStep 4) (VClear 1)))
(step 16 (LStep 4)
  (del (fiber 4 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (add
    (fiber 4 provider (life Loading) (view) (target) (next done) (acc (prov tools 5)))
    (bind tools (pid 5) (owner 4) (entries)))
  (enabled (LStep 4) (VClear 1)))
(step 17 (LStep 4)
  (del
    (fiber 1 consumer (life Inactive EOp) (target none))
    (fiber 4 provider (life Loading) (view) (target) (next done) (acc (prov tools 5))))
  (add
    (fiber 1 consumer (life Inactive EOp) (target (tools 5)))
    (fiber 4 provider (life Active) (view) (target) (acc (prov tools 5))))
  (enabled (VClear 1)))
(step 18 (VClear 1)
  (del (fiber 1 consumer (life Inactive EOp) (target (tools 5))))
  (add (fiber 1 consumer (life Inactive) (target (tools 5))))
  (enabled (LBegin 1)))
(step 19 (LBegin 1)
  (del (fiber 1 consumer (life Inactive) (target (tools 5))))
  (add (fiber 1 consumer (life Loading) (view (tools 5)) (target (tools 5)) (next (op tools (register 7 42))) (acc)))
  (enabled (LStep 1)))
(step 20 (LStep 1)
  (del
    (fiber 1 consumer (life Loading) (view (tools 5)) (target (tools 5)) (next (op tools (register 7 42))) (acc))
    (bind tools (pid 5) (owner 4) (entries)))
  (add
    (fiber 1 consumer (life Loading) (view (tools 5)) (target (tools 5)) (next done) (acc (op tools 5 (register 7 42))))
    (bind tools (pid 5) (owner 4) (entries (7 42))))
  (enabled (LStep 1)))
(step 21 (LStep 1)
  (del
    (fiber 1 consumer (life Loading) (view (tools 5)) (target (tools 5)) (next done) (acc (op tools 5 (register 7 42)))))
  (add (fiber 1 consumer (life Active) (view (tools 5)) (target (tools 5)) (acc (op tools 5 (register 7 42)))))
  (enabled))
(final
  (fiber 1 consumer (life Active) (view (tools 5)) (target (tools 5)) (acc (op tools 5 (register 7 42))))
  (fiber 4 provider (life Active) (view) (target) (acc (prov tools 5)))
  (bind tools (pid 5) (owner 4) (entries (7 42)))
  (fview 0)
  (fview 1 (tools 2))
  (quiet #t))
