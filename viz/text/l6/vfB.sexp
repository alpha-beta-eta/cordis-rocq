(run "ViewFail B (step)")
(init (enabled))
(step 1 (OInsert provider7) (del) (add (fiber 0 provider7 (life Inactive) (target))) (enabled (LBegin 0)))
(step 2 (OInsert consumer) (del) (add (fiber 1 consumer (life Inactive) (target none))) (enabled (LBegin 0)))
(step 3 (ODispose 0)
  (del (fiber 0 provider7 (life Inactive) (target)))
  (add (fiber 0 provider7 (life Inactive) disposed (target none)))
  (enabled (LRemove 0)))
(step 4 (LRemove 0) (del (fiber 0 provider7 (life Inactive) disposed (target none))) (add) (enabled))
(step 5 (OInsert provider) (del) (add (fiber 2 provider (life Inactive) (target))) (enabled (LBegin 2)))
(step 6 (LBegin 2)
  (del (fiber 2 provider (life Inactive) (target)))
  (add (fiber 2 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (enabled (LStep 2)))
(step 7 (LStep 2)
  (del (fiber 2 provider (life Loading) (view) (target) (next (provide tools)) (acc)))
  (add
    (fiber 2 provider (life Loading) (view) (target) (next done) (acc (prov tools 3)))
    (bind tools (pid 3) (owner 2) (entries)))
  (enabled (LStep 2)))
(step 8 (LStep 2)
  (del
    (fiber 1 consumer (life Inactive) (target none))
    (fiber 2 provider (life Loading) (view) (target) (next done) (acc (prov tools 3))))
  (add
    (fiber 1 consumer (life Inactive) (target (tools 3)))
    (fiber 2 provider (life Active) (view) (target) (acc (prov tools 3))))
  (enabled (LBegin 1)))
(step 9 (LBegin 1)
  (del (fiber 1 consumer (life Inactive) (target (tools 3))))
  (add (fiber 1 consumer (life Loading) (view (tools 3)) (target (tools 3)) (next (op tools (register 7 42))) (acc)))
  (enabled (LStep 1)))
(step 10 (LStep 1)
  (del
    (fiber 1 consumer (life Loading) (view (tools 3)) (target (tools 3)) (next (op tools (register 7 42))) (acc))
    (bind tools (pid 3) (owner 2) (entries)))
  (add
    (fiber 1 consumer (life Loading) (view (tools 3)) (target (tools 3)) (next done) (acc (op tools 3 (register 7 42))))
    (bind tools (pid 3) (owner 2) (entries (7 42))))
  (enabled (LStep 1)))
(step 11 (LStep 1)
  (del
    (fiber 1 consumer (life Loading) (view (tools 3)) (target (tools 3)) (next done) (acc (op tools 3 (register 7 42)))))
  (add (fiber 1 consumer (life Active) (view (tools 3)) (target (tools 3)) (acc (op tools 3 (register 7 42)))))
  (enabled))
(final
  (fiber 1 consumer (life Active) (view (tools 3)) (target (tools 3)) (acc (op tools 3 (register 7 42))))
  (fiber 2 provider (life Active) (view) (target) (acc (prov tools 3)))
  (bind tools (pid 3) (owner 2) (entries (7 42)))
  (quiet #t))
