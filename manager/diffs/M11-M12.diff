+            (ctx-on-dispose ctx 'tools (λ (s) (hash-remove s "tmp")))
+            (when (eq? config 'crash) (error "中途出错")))))
+;renamer 先登记 x, 再把 x 改名为 y; 后一步依赖前一步
+(define ((rename-entry from to) tok state)
+  (and (hash-has-key? state from) (not (hash-has-key? state to))
+       (op-result (hash-remove (hash-set state to (hash-ref state from)) from)
+                  (λ (state)
+                    (if (hash-has-key? state to)
+                        (hash-remove (hash-set state from (hash-ref state to)) to)
+                        state))
+                  'ok)))
+(define renamer
+  (plugin "renamer" '(tools) '()
+          (λ (ctx)
+            (ctx-use ctx 'tools (register "x" "临时名"))
+            (ctx-use ctx 'tools (rename-entry "x" "y")))))
