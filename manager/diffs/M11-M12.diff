+;读任何服务的状态, 没有时为#f; 不声明依赖, 不进视图 (Cordis: ctx.get)
+(define (ctx-get c key)
+  (check-in-apply 'ctx-get c)
+  (define key* ((ctx-rename c) key))
+  (shift-at apply-tag k (Get key* k)))
+;直接把服务的状态改成 (f 状态), 不交出逆 (Cordis: 猴补丁, 裸改动)
+(define (ctx-mutate! c key f)
+  (check-in-apply 'ctx-mutate! c)
+  (define key* ((ctx-rename c) key))
+  (shift-at apply-tag k (Mutate key* f k)))
+;另外登记一个 disposer: 卸载时把服务的状态改成 (undo 状态) (Cordis: ctx.effect 的清理函数)
+(define (ctx-on-dispose c key undo)
+  (check-in-apply 'ctx-on-dispose c)
+  (define key* ((ctx-rename c) key))
+  (shift-at apply-tag k (Defer key* undo k)))
 
